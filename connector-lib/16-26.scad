// MIL-DTL-26482 plug, shell 16, 16-26, pin insert
// Generated by connector_gen.py. Dimensions in mm, viewed from the engaging
// face (+Z), master key at +Y.

/* [Part] */
part = "both"; // [both, plug, retainer, assembled]

/* [Plug] */
depth = 12.32;

/* [Mounting ears] */
screw_hole_d = 2.5; // M2 clearance
ear_wall = 1.5; // material around the screw hole
ear_thickness = 2;
ear_angle = 90; // ears at this angle and +180, clockwise from the master key

/* [Retainer plate] */
retainer_thickness = 2;
ret_d_20 = 2.2; // contact size 20

/* [Holes] */
hole_d_20 = 2.5; // contact size 20

/* [Counterbores at the rear face] */
cb_d_20 = 3; // contact size 20
cb_depth_20 = 0.85; // contact size 20

/* [Resolution] */
$fn = 96;

/* [Hidden] */
shell_od = 21.463;  // Y, plug shell OD
key_od = 23.4823;  // X, diameter over keys

// [angle clockwise from master key, width]
keys = [
    [0, 2.8448],
    [105, 1.1176],
    [140, 1.1176],
    [215, 1.1176],
    [265, 1.1176]
];

// [label, x, y, contact size]
contacts = [
    ["A", 0, 8.1534, "20"],
    ["B", 3.3274, 7.4422, "20"],
    ["C", 6.0706, 5.4356, "20"],
    ["D", 7.747, 2.5146, "20"],
    ["E", 8.1026, -0.8636, "20"],
    ["F", 7.0612, -4.0894, "20"],
    ["G", 4.8006, -6.604, "20"],
    ["H", 1.7018, -7.9756, "20"],
    ["J", -1.7018, -7.9756, "20"],
    ["K", -4.8006, -6.604, "20"],
    ["L", -7.0612, -4.0894, "20"],
    ["M", -8.1026, -0.8636, "20"],
    ["N", -7.747, 2.5146, "20"],
    ["P", -6.0706, 5.4356, "20"],
    ["R", -3.3274, 7.4422, "20"],
    ["S", -1.778, 4.4958, "20"],
    ["T", 1.778, 4.4958, "20"],
    ["U", 4.445, 2.3876, "20"],
    ["V", 4.5212, -0.9144, "20"],
    ["W", 3.0226, -3.8354, "20"],
    ["X", 0, -5.1562, "20"],
    ["Y", -3.0226, -3.8354, "20"],
    ["Z", -4.5212, -0.9144, "20"],
    ["a", -4.445, 2.3876, "20"],
    ["b", 0, 1.651, "20"],
    ["c", 0, -1.651, "20"]
];

function hole_d(size) = size == "20" ? hole_d_20 : undef;
function cb_d(size) = size == "20" ? cb_d_20 : 0;
function cb_depth(size) = size == "20" ? cb_depth_20 : 0;
function ret_d(size) = size == "20" ? ret_d_20 : undef;

ear_w = screw_hole_d + 2 * ear_wall;
screw_r = key_od / 2 + ear_w / 2; // screw holes clear of the keys

module keyed_profile() {
    intersection() {
        circle(d = key_od);
        union() {
            circle(d = shell_od);
            for (k = keys)
                rotate(-k[0]) translate([-k[1] / 2, 0]) square([k[1], key_od]);
        }
    }
}

module holes() {
    for (c = contacts)
        translate([c[1], c[2], -1]) {
            cylinder(d = hole_d(c[3]), h = depth + 2);
            if (cb_d(c[3]) > 0)
                cylinder(d = cb_d(c[3]), h = cb_depth(c[3]) + 1);
        }
}

module ears() {
    for (a = [ear_angle, ear_angle + 180])
        rotate(-a) hull() {
            circle(d = ear_w);
            translate([0, screw_r]) circle(d = ear_w);
        }
}

module screw_holes(h) {
    for (a = [ear_angle, ear_angle + 180])
        rotate(-a) translate([0, screw_r, -1]) cylinder(d = screw_hole_d, h = h + 2);
}

module plug() {
    difference() {
        union() {
            linear_extrude(depth) keyed_profile();
            linear_extrude(ear_thickness) ears();
        }
        holes();
        screw_holes(depth);
    }
}

// Sits against the rear face of the plug in this orientation (do not flip).
module retainer() {
    difference() {
        linear_extrude(retainer_thickness) union() {
            circle(d = shell_od);
            ears();
        }
        for (c = contacts)
            translate([c[1], c[2], -1]) cylinder(d = ret_d(c[3]), h = retainer_thickness + 2);
        screw_holes(retainer_thickness);
    }
}

if (part == "plug") plug();
else if (part == "retainer") retainer();
else if (part == "assembled") {
    plug();
    translate([0, 0, -retainer_thickness]) retainer();
} else {
    plug();
    // Next to the plug, perpendicular to the ears.
    rotate(-ear_angle - 90) translate([0, key_od / 2 + shell_od / 2 + 5, 0])
        rotate(ear_angle + 90) retainer();
}
